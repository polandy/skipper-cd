repo_url: ssh://git@gitea.example.com/user/nixos-config.git
repo_dir: /var/lib/skipper/repo         # optional, default: /var/lib/skipper/repo
branch: main                            # optional, default: main
vars_file: /etc/skipper/vars.env        # optional, changes trigger redeploy
command_timeout_seconds: 300            # optional, default: 300 (5 minutes)
stacks_base_dir: /var/lib/skipper/repo/modules
webhook_secret: "your-secret-here"
port: 8080
metrics_port: 9120
ui_enabled: false                      # enable the real-time web UI on the webhook port
# ui_theme: catppuccin                 # optional, default: catppuccin. One of: catppuccin,
                                        # nord, solarized, gruvbox, rose-pine. Useful to tell
                                        # multiple skipper-cd instances apart at a glance.
# ui_theme_switcher: false             # optional, default: false. When true, shows an in-UI
                                        # palette picker (a per-browser override) — handy for
                                        # trying themes out; off keeps the deployed theme fixed.

stacks:
  - name: traefik
    env_files:
      - /run/secrets/rendered/skipper/compose.env

  - name: gitea
    env_files:
      - /run/secrets/rendered/skipper/compose.env
    # Optional post-deploy health gate → rollback on failure. `up` runs with
    # --wait, so it waits for the service's compose `healthcheck:` (which runs
    # INSIDE the container — no published port needed). `url` adds an extra HTTP
    # probe FROM THE HOST, only for endpoints reachable there. See docs/configuration.md.
    # health_check:
    #   timeout_seconds: 60                # optional, default: 60
    #   # url: http://localhost:3000/healthz # optional; host-reachable endpoints only

  - name: monitoring
    env_files:
      - /run/secrets/rendered/skipper/compose.env
    icon: grafana    # optional web-UI icon slug; overrides the auto-match on the stack name

  # Set working_dir when a NixOS systemd service also manages this stack,
  # so Docker Compose uses the same project identity for both.
  - name: nextcloud
    working_dir: /etc/nixos/modules/nextcloud
    env_files:
      - /run/secrets/rendered/skipper/compose.env

# NixOS rebuild: triggered when any .nix file or flake.lock changes.
# The skipper-cd systemd service must run as root for nixos-rebuild to work.
# Omit this section entirely to disable NixOS rebuild.
nixos_rebuild:
  flake: ".#nuc"    # required; passed as: nixos-rebuild switch --flake <flake>
  # enabled: false  # set to false to temporarily disable without removing the section

# Web-UI service icons (only used when ui_enabled). Omit to use the defaults below.
# icons:
#   cache_dir: /var/lib/skipper/icons
#   source_url: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons  # <root>/<fmt>/<slug>.<fmt>, tries svg,png,webp

# Outbound notifications on terminal deploy outcomes (works with the UI off).
# Omit the section entirely to disable. See docs/configuration.md#notifications.
# notifications:
#   - format: signal                       # signal | generic (default: generic)
#     url: http://localhost:8020           # signal-api base; /v2/send is appended
#     number: "+491234567890"              # sender (required for signal)
#     recipients: ["+491234567890"]        # recipients (required for signal)
#     # on: [failed, success, rolled_back] # default; subset of these three
#   - format: generic                      # a second, independent target for failures
#     url: https://ntfy.example.com/skipper
#     headers:
#       Authorization: "Bearer your-token"
#     on: [failed, rolled_back]
