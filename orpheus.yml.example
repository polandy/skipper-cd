repo_path: /etc/nixos
stacks_base_dir: /etc/nixos/modules
webhook_secret: "your-secret-here"
port: 8080
metrics_port: 9120

stacks:
  - name: traefik
    env_files:
      - /run/secrets/rendered/orpheus/compose.env

  - name: gitea
    env_files:
      - /run/secrets/rendered/orpheus/compose.env

  - name: monitoring
    env_files:
      - /run/secrets/rendered/orpheus/compose.env

  # Override working_dir for stacks not directly under stacks_base_dir
  - name: apc-monitor
    working_dir: /etc/nixos/modules/monitoring/apc-monitor
    env_files:
      - /run/secrets/rendered/orpheus/compose.env
